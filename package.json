{
  "name": "trail-flyover",
  "version": "0.4.1",
  "private": true,
  "description": "Smooth 3D/2D fly-over of a GPS track for MapLibre GL, with MP4/WebM video export",
  "license": "MIT",
  "author": "Zdenek Pracny",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zpracny/trail-flyover.git"
  },
  "homepage": "https://github.com/zpracny/trail-flyover#readme",
  "bugs": {
    "url": "https://github.com/zpracny/trail-flyover/issues"
  },
  "keywords": [
    "maplibre",
    "gps",
    "gpx",
    "flyover",
    "3d",
    "video",
    "webcodecs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "README.cs.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:lib": "node scripts/build-lib.mjs",
    "prepare": "npm run build:lib",
    "watch": "node scripts/build.mjs --watch",
    "serve": "python3 scripts/devserver.py 8811",
    "pretest": "npm run build:lib",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "check": "npm run typecheck && npm run lint && npm test",
    "compare": "node scripts/compare-smoothness.ts"
  },
  "peerDependencies": {
    "maplibre-gl": ">=5.0.0"
  },
  "dependencies": {
    "mediabunny": "^1.66.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "maplibre-gl": "^6.19.0",
    "typescript": "^7.0.2"
  }
}
